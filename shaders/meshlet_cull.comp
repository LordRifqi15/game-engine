#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GPUMeshlet {
    vec4 boundingSphere;
    vec4 normalCone; // xyz: axis, w: sin(cutoff)
    uint vertexOffset;
    uint vertexCount;
    uint triangleOffset;
    uint triangleCount;
    uint pageID;     // residency page (CPU bakes into padding[0])
    uint pad0;
    uint pad1;
    uint pad2;
};

struct GPUMeshInstance {
    mat4 model;
    uint meshletOffset;
    uint meshletCount;
    uint materialID;
    uint flags;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

// Residency protocol (synchronous upload keeps every page resident; the guard
// below still skips unloaded pages and queues a request instead of indexing
// garbage).
const uint PAGE_RESIDENT = 2;
const uint PAGE_UNLOADED = 0;

layout(std430, set = 0, binding = 0) readonly buffer MeshletsSSBO { GPUMeshlet meshlets[]; };
layout(std430, set = 0, binding = 1) readonly buffer InstancesSSBO { GPUMeshInstance instances[]; };
layout(std430, set = 0, binding = 2) readonly buffer UniqueVerticesSSBO { uint uniqueVertexIndices[]; };
layout(std430, set = 0, binding = 3) readonly buffer LocalTrianglesSSBO { uint packedLocalIndices[]; };

layout(std430, set = 0, binding = 4) buffer CompactedIndexBuffer { uint globalIndexStream[]; };
layout(std430, set = 0, binding = 5) buffer IndirectDrawBuffer { DrawIndexedIndirectCommand drawCommand; };

layout(set = 0, binding = 6) uniform sampler2D hizPyramid;
layout(std430, set = 0, binding = 7) buffer ResidencySSBO { uint pageStatus[]; };
layout(std430, set = 0, binding = 8) buffer PageRequestSSBO { uint requestCount; uint requests[]; };

layout(set = 0, binding = 9) uniform CullCameraUBO {
    mat4 view;
    mat4 proj;
    vec4 frustumPlanes[6];
} camera;

layout(push_constant) uniform CullParams {
    vec3 cameraWorldPos;
    float zNear;
    vec2 hizExtent;
    uint maxMipLevel;
    uint totalMeshlets;
} push;

bool isConeBackfacing(vec3 coneCenter, vec3 coneAxis, float sinCutoff) {
    vec3 viewDir = normalize(coneCenter - push.cameraWorldPos);
    return dot(viewDir, coneAxis) > sinCutoff;
}

bool isFrustumVisible(vec3 center, float radius) {
    for (int i = 0; i < 6; ++i) {
        if (dot(camera.frustumPlanes[i].xyz, center) + camera.frustumPlanes[i].w < -radius) return false;
    }
    return true;
}

bool isOccludedByHiZ(vec3 center, float radius) {
    vec4 viewC = camera.view * vec4(center, 1.0);
    float dist = -viewC.z;
    if (dist <= push.zNear + radius) return false; // near-plane guard: keep
    vec4 clip = camera.proj * viewC;
    if (clip.w <= 0.0) return false;
    // Vulkan texel (0,0) displays top-left while NDC (-1,-1) maps to the
    // bottom-left pixel: mirror V relative to the Y-flipped projection.
    vec2 uv = vec2(clip.x / clip.w * 0.5 + 0.5, 0.5 - clip.y / clip.w * 0.5);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return false;
    // Screen-space radius via projection scale factors (abs: Vulkan Y is flipped).
    vec2 radiusUV = vec2(radius * abs(camera.proj[0][0]), radius * abs(camera.proj[1][1])) / clip.w;
    float maxR = max(radiusUV.x, radiusUV.y);
    vec2 extentPx = maxR * 2.0 * push.hizExtent;
    float mip = clamp(ceil(log2(max(max(extentPx.x, extentPx.y), 1.0))), 0.0, float(push.maxMipLevel));
    float occluderDepth = textureLod(hizPyramid, uv, mip).r;
    // Device depth of the sphere's nearest point toward the camera.
    float nearestDist = max(dist - radius, push.zNear);
    vec4 nearView = vec4(viewC.xyz * (nearestDist / dist), 1.0);
    vec4 nearClip = camera.proj * nearView;
    float nearestDepth = clamp((nearClip.z / nearClip.w) * 0.5 + 0.5, 0.0, 1.0);
    return nearestDepth > occluderDepth + 1e-4;
}

void main() {
    uint globalMeshletID = gl_GlobalInvocationID.x;
    if (globalMeshletID >= push.totalMeshlets) return;

    GPUMeshlet m = meshlets[globalMeshletID];
    vec3 worldCenter = m.boundingSphere.xyz;
    float radius = m.boundingSphere.w;
    // 0. Residency gate: never index an unloaded page. Queue a request and skip.
    if (pageStatus[m.pageID] != PAGE_RESIDENT) {
        uint slot = atomicAdd(requestCount, 1);
        if (slot < 1024) requests[slot] = m.pageID;
        return;
    }

    // 1. Backface cone culling
    if (isConeBackfacing(worldCenter, m.normalCone.xyz, m.normalCone.w)) return;
    // 2. Frustum culling
    if (!isFrustumVisible(worldCenter, radius)) return;
    // 3. Hi-Z occlusion against the previous frame's depth pyramid
    if (isOccludedByHiZ(worldCenter, radius)) return;

    // 4. Atomically reserve space in the global compacted index buffer
    uint indexCount = m.triangleCount * 3;
    uint dstOffset = atomicAdd(drawCommand.indexCount, indexCount);

    // 5. Unpack local 8-bit triangle indices into global 32-bit vertex indices
    for (uint i = 0; i < indexCount; ++i) {
        uint localVertexIdx = packedLocalIndices[m.triangleOffset + i];
        uint globalVertexIdx = uniqueVertexIndices[m.vertexOffset + localVertexIdx];
        globalIndexStream[dstOffset + i] = globalVertexIdx;
    }
}
